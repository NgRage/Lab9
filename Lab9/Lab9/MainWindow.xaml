<Window x:Class="Lab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №9 (Вариант 5)" Height="500" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Координата X:" FontWeight="Bold"/>
            <TextBox x:Name="tbX" Margin="0,5,0,10" Padding="3"/>

            <TextBlock Text="Координата Y:" FontWeight="Bold"/>
            <TextBox x:Name="tbY" Margin="0,5,0,15" Padding="3"/>

            <Button Content="Создать отрезок" Click="BtnCreate_Click" Padding="5" Margin="0,0,0,20"/>

            <TextBlock Text="Число для Contains и оператора &lt; :" TextWrapping="Wrap"/>
            <TextBox x:Name="tbCheckNumber" Margin="0,5,0,10" Padding="3"/>

            <TextBlock Text="Целое число (d) для сложения:"/>
            <TextBox x:Name="tbAddNumber" Margin="0,5,0,10" Padding="3"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Доступные операции:" FontWeight="Bold" Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,15">
                    <Button Content="(Задание 2)" Click="BtnContains_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Длина ( ! )" Click="BtnLength_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Увеличить ( ++ )" Click="BtnIncrement_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Явно в int (X)" Click="BtnCastInt_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Неявно в double (Y)" Click="BtnCastDouble_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Сложить с d ( + )" Click="BtnAdd_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Вхождение числа ( &lt; )" Click="BtnOperatorLess_Click" Margin="0,0,5,5" Padding="5"/>
                    <Button Content="Очистить лог" Click="BtnClear_Click" Margin="0,0,5,5" Padding="5"/>
                </WrapPanel>

                <TextBlock Text="Результат выполнения:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border BorderBrush="Gray" BorderThickness="1" Background="#F9F9F9" MinHeight="200">
                    <TextBlock x:Name="tbResult" TextWrapping="Wrap" Padding="10" FontFamily="Consolas"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>